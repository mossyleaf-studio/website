<main class="prerender">
    <header class="prerender__header">
        {% if site.logo %}
            <img src="{{ site.logo.url }}" alt="" width="{{ site.logo.width }}" height="{{ site.logo.height }}">
        {% endif %}
        <h1>{{ site.studioName }}</h1>
        <p>{{ site.intro }}</p>
    </header>

    {% if site.featured %}
        <figure>
            <img src="{{ site.featured.url }}" alt="{{ site.featured.alt }}" width="{{ site.featured.width }}" height="{{ site.featured.height }}" fetchpriority="high">
        </figure>
    {% endif %}

    {% if page == 'full' %}
        {% if site.links is not empty %}
            <nav aria-label="Find {{ site.studioName }}">
                <ul>
                    {% for link in site.links %}
                        <li><a href="{{ link.url }}">{{ link.title }}</a> <span>{{ link.description }}</span></li>
                    {% endfor %}
                </ul>
            </nav>
        {% endif %}

        {% if site.gallery.artworks is not empty %}
            <section aria-labelledby="gallery-title">
                <h2 id="gallery-title">{{ site.gallery.title }}</h2>
                <ul>
                    {% for artwork in site.gallery.artworks %}
                        <li><img src="{{ artwork.url }}" alt="{{ artwork.alt }}" width="{{ artwork.width }}" height="{{ artwork.height }}" loading="lazy"></li>
                    {% endfor %}
                </ul>
            </section>
        {% endif %}

        <section aria-labelledby="about-title">
            <h2 id="about-title">{{ site.about.title }}</h2>
            {% for paragraph in site.about.paragraphs %}
                <p>{{ paragraph|rich_text }}</p>
            {% endfor %}
        </section>
    {% else %}
        <section aria-labelledby="note-title">
            <h2 id="note-title">{{ site.homeNote.title }}</h2>
            <p>{{ site.homeNote.text|rich_text }}</p>
        </section>
    {% endif %}

    <footer>
        <p>© {{ 'now'|date('Y') }} {{ site.studioName }}</p>
    </footer>
</main>
