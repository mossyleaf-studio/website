<h1>{{ data.title }}</h1>
<div class="shop-prerender__body">
    <div data-paragraphs>
        {% for paragraph in data.paragraphs %}
            <p>{{ paragraph|rich_text }}</p>
        {% endfor %}
    </div>
    {% if data.featured %}
        <figure>
            <img src="{{ data.featured.url }}" alt="{{ data.featured.alt }}" width="{{ data.featured.width }}" height="{{ data.featured.height }}" fetchpriority="high">
        </figure>
    {% endif %}
</div>
{% if data.gallery.artworks is not empty %}
    <section aria-labelledby="gallery-title">
        <h2 id="gallery-title">{{ data.gallery.title }}</h2>
        <ul class="shop-prerender__gallery">
            {% for artwork in data.gallery.artworks %}
                <li><img src="{{ artwork.url }}" alt="{{ artwork.alt }}" width="{{ artwork.width }}" height="{{ artwork.height }}" loading="lazy"></li>
            {% endfor %}
        </ul>
    </section>
{% endif %}
