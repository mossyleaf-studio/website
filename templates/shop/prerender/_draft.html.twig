<aside class="shop-prerender__draft" aria-label="{{ 'draft.region'|site_t }}" data-draft>
    <p><strong>{{ 'draft.title'|site_t }}</strong> {{ 'draft.text'|site_t }}</p>
    <nav aria-label="{{ 'draft.region'|site_t }}">
        <ul>
            <li><a href="{{ layout.draft.shop }}" aria-current="page">{{ 'draft.shop'|site_t }}</a></li>
            <li><a href="{{ layout.draft.note }}">{{ 'draft.note'|site_t }}</a></li>
            <li><a href="{{ layout.draft.admin }}">{{ 'draft.admin'|site_t }}</a></li>
        </ul>
    </nav>
</aside>
