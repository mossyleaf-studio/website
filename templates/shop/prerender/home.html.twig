<div class="shop-prerender__hero">
    <div class="shop-prerender__lead">
        <h1>{{ data.intro }}</h1>
        {% if data.shopUrl %}
            <p><a class="shop-prerender__pill" href="{{ data.shopUrl }}" data-shop>{{ 'home.shopLink'|site_t }}</a></p>
        {% endif %}
    </div>
    {% if data.featured %}
        <figure>
            <img src="{{ data.featured.url }}" alt="{{ data.featured.alt }}" width="{{ data.featured.width }}" height="{{ data.featured.height }}" fetchpriority="high">
        </figure>
    {% endif %}
</div>
{% if data.products is defined %}
    <section aria-labelledby="latest-title" data-latest>
        <h2 id="latest-title">{{ 'home.latest'|site_t }}</h2>
        {% include 'shop/prerender/_cards.html.twig' with {products: data.products, eager: false} %}
    </section>
{% endif %}
<section class="shop-prerender__sheet" aria-labelledby="about-title" data-about>
    <h2 id="about-title">{{ data.about.title }}</h2>
    <p>{{ data.about.text|rich_text }}</p>
    <p><a href="{{ data.about.url }}">{{ 'home.aboutLink'|site_t }}</a></p>
</section>
{% if data.categories is defined %}
    <section aria-labelledby="categories-title">
        <h2 id="categories-title">{{ 'home.categories'|site_t }}</h2>
        <ul class="shop-prerender__tiles" data-tiles>
            {% for tile in data.categories %}
                <li>
                    <a href="{{ tile.url }}">
                        {% if tile.image %}
                            <img src="{{ tile.image.src }}" srcset="{{ tile.image.srcset }}" sizes="(min-width: 87.5rem) 16rem, (min-width: 56rem) 20vw, (min-width: 40rem) 33vw, 50vw" alt="" width="{{ tile.image.width }}" height="{{ tile.image.height }}" loading="lazy">
                        {% else %}
                            <span class="shop-prerender__blank"></span>
                        {% endif %}
                        <span>{{ tile.label }}</span>
                    </a>
                </li>
            {% endfor %}
        </ul>
    </section>
{% endif %}
{% if data.nextConvention is defined %}{% include 'shop/prerender/_next_convention.html.twig' %}{% endif %}
