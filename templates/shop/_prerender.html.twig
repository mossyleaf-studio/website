{% set home = (layout.navigation|filter(entry => entry.key == 'home')|first).url %}
<div class="shop-prerender">
    <a class="shop-prerender__skip" href="#main">{{ 'layout.skip'|site_t }}</a>
    {% if layout.draft is defined %}
        {% include 'shop/prerender/_draft.html.twig' %}
    {% endif %}
    {% if layout.announcement %}
        <p class="shop-prerender__announcement" data-announcement>{{ layout.announcement }}</p>
    {% endif %}

    <header class="shop-prerender__header">
        <div class="shop-prerender__bar">
            {% include 'shop/prerender/_languages.html.twig' %}
            <a class="shop-prerender__home" href="{{ home }}" data-home>
                {%- if layout.logo -%}
                    <img src="{{ layout.logo.url }}" alt="" width="{{ layout.logo.width }}" height="{{ layout.logo.height }}"><span class="visually-hidden">{{ layout.studioName }}</span>
                {%- else -%}
                    {{ layout.studioName }}
                {%- endif -%}
            </a>
            <a class="shop-prerender__cart" href="{{ layout.cartUrl }}"{% if data.page == 'cart' %} aria-current="page"{% endif %} data-cart><svg class="shop-prerender__cart-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M16 10a4 4 0 0 1-8 0"/><path d="M3.103 6.034h17.794"/><path d="M3.4 5.467a2 2 0 0 0-.4 1.2V20a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6.667a2 2 0 0 0-.4-1.2l-2-2.667A2 2 0 0 0 17 2H7a2 2 0 0 0-1.6.8z"/></svg><span class="shop-prerender__cart-word">{{ 'cart.link'|site_t }}</span></a>
        </div>
        <nav class="shop-prerender__navigation" aria-label="{{ 'layout.navigation'|site_t }}" data-navigation>
            <ul>
                {% for entry in layout.navigation %}
                    <li{% if entry.children is defined %} class="shop-prerender__shop"{% endif %}>
                        <a href="{{ entry.url }}"{% if entry.current %} aria-current="{{ entry.children is defined ? 'true' : 'page' }}"{% endif %}{% if entry.children is defined %} data-shop-menu{% endif %}>{{ ('nav.' ~ entry.key)|site_t }}{% if entry.children is defined %}<svg class="shop-prerender__chevron" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="m6 9 6 6 6-6"/></svg>{% endif %}</a>
                        {%- if entry.children is defined %}
                            <ul class="shop-prerender__categories" data-categories>
                                {% for child in entry.children %}
                                    <li><a href="{{ child.url }}"{% if child.current %} aria-current="page"{% endif %}>{{ child.label }}</a></li>
                                {% endfor %}
                            </ul>
                        {% endif %}
                    </li>
                {% endfor %}
            </ul>
        </nav>
    </header>

    <main id="main" class="shop-prerender__main">
        {% include 'shop/prerender/' ~ data.page ~ '.html.twig' %}
    </main>

    <footer class="shop-prerender__footer">
        <h2>{{ layout.studioName }}</h2>
        <p>{{ layout.intro }}</p>
        {% if layout.footer.links is not empty %}
            <nav aria-label="{{ 'footer.links'|site_t }}" data-links>
                <ul>
                    {% for link in layout.footer.links %}
                        <li><a href="{{ link.url }}"{% if link.url matches '{^https://(www\\.)?instagram\\.com(/|$)}' %} rel="me"{% endif %}>{{ link.title }}</a></li>
                    {% endfor %}
                </ul>
            </nav>
        {% endif %}
        {% if layout.footer.legal is not empty %}
            <nav aria-label="{{ 'legal.footer'|site_t }}" data-legal>
                <ul>
                    {% for page in layout.footer.legal %}
                        <li><a href="{{ page.url }}">{{ ('legal.title.' ~ page.kind)|site_t }}</a></li>
                    {% endfor %}
                </ul>
            </nav>
        {% endif %}
        {% include 'shop/prerender/_languages.html.twig' with {landmark: false} %}
        <p>{{ 'footer.copyright'|site_t({year: 'now'|date('Y'), studio: layout.studioName}) }}</p>
    </footer>
</div>
